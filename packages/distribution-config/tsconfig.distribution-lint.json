{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "composite": false,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../distribution-support/src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "release",
    "release-*",
    "test-results",
    "playwright-report"
  ]
}
